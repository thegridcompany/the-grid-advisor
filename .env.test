# Test Environment Configuration
# This file is used for running tests inside Docker

# Application Settings
APP_NAME="Grid Brain Test"
APP_VERSION="1.0.0-test"
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001

# Security Keys (test values - DO NOT USE IN PRODUCTION)
SECRET_KEY=test-secret-key-for-testing-only
ENCRYPTION_KEY=test-encryption-key-for-testing-only
JWT_SECRET_KEY=test-jwt-secret-key-for-testing-only
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Supabase Configuration (test values)
SUPABASE_URL=https://test-project.supabase.co
SUPABASE_ANON_KEY=test-supabase-anon-key
SUPABASE_SERVICE_KEY=test-supabase-service-key

# AI Services (test values)
ANTHROPIC_API_KEY=test-anthropic-api-key
OPENAI_API_KEY=test-openai-api-key
PERPLEXITY_API_KEY=test-perplexity-api-key
OPENROUTER_API_KEY=test-openrouter-api-key
AI_MODEL_NAME=claude-3-opus-20240229
EMBEDDING_MODEL=text-embedding-3-small
AI_ANALYSIS_THRESHOLD=0.8

# Email Configuration (test values)
EMAIL_POLLING_INTERVAL=300
EMAIL_SERVER_IMAP=test.imap.server
EMAIL_SERVER_SMTP=test.smtp.server
EMAIL_PORT_IMAP=993
EMAIL_PORT_SMTP=465
SYSTEM_EMAIL_ADDRESS=test@example.com
SYSTEM_EMAIL_PASSWORD=test-password

# Redis Cache (for testing)
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Monitoring
SENTRY_DSN=
LOG_LEVEL=DEBUG

# Background Tasks
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Business Logic
RESPONSE_TIME_ALERT_HOURS=24
CLIENT_SILENCE_ALERT_DAYS=14
PROPOSAL_FOLLOWUP_DAYS=7
INVOICE_OVERDUE_DAYS=30

# Memory System
MEMORY_SHORT_TERM_DAYS=30
MEMORY_DECAY_FACTOR=0.95

# Company
COMPANY_EMAIL_DOMAIN=example.com

# Frontend
FRONTEND_URL=http://localhost:3000