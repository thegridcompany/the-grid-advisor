#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running frontend tests (Jest)..."
npm test
FRONTEND_TEST_RESULT=$?

if [ $FRONTEND_TEST_RESULT -ne 0 ]; then
  echo "Frontend tests failed! Commit aborted."
  exit 1
fi

echo "Frontend tests passed."
echo "Running backend tests (pytest)..."
# Navigate to the project root to run backend tests
cd ..
pytest
BACKEND_TEST_RESULT=$?
# Navigate back to the frontend directory
cd grid-brain-frontend

if [ $BACKEND_TEST_RESULT -ne 0 ]; then
  echo "Backend tests failed! Commit aborted."
  exit 1
fi

echo "Backend tests passed."
echo "All pre-commit checks passed. Proceeding with commit."
exit 0
